{
    "block_type": "SEW",
    "model_name": "SNN_Net",
    "hidden": 256,
    "tau": 2.0,
    "final_tau": 20.0,
    "reset_type": "soft",
    "surrogate_function": "ATan",
    "Plif": false,
    "norm_type": "BN",
    "learnable_norm": true,
    "init_scale": 5.0,
    "K": 10,
    "transient": 0,
    "batch_size": 4,
    "sequence_length": 2000,
    "optimizer": "Adam",
    "learning_rate": 0.0001,
    "weight_decay": 0.0,
    "scheduler": "ReduceLROnPlateau",
    "scheduler_factor": 0.5,
    "scheduler_patience": 1,
    "min_lr": 1e-06,
    "num_epochs": 30,
    "device": "cuda",
    "early_stop_patience": 10
}